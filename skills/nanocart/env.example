# NanoCart credentials — copy to .env and fill in. Keep .env OUT of git.
#
# Store ID: public slug of your store (portal.nanocart.io -> Settings -> Store Information).
# Safe to expose; it also goes in the widget script tag as data-store-id.
NANOCART_STORE_ID=

# Admin API key: SECRET. Full admin access to your store (products, orders, settings).
# Server-side / CLI use only. Never put this in website code or the script tag.
# Found in portal.nanocart.io -> Settings -> API Keys. Regenerate it if it ever leaks.
NANOCART_API_KEY=
